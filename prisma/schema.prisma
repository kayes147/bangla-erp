generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Model for RBAC
model User {
  id             String         @id @default(cuid())
  username       String         @unique
  password       String         // In a real app, this will be hashed
  role           String         // "OWNER", "MANAGER", "CLIENT"
  image          String?        @db.Text // Profile Photo (Base64)
  
  // Relations
  clientId       String?        @unique // If role is CLIENT
  client         Client?        @relation(fields: [clientId], references: [id])
  employeeId     String?        @unique // If role is MANAGER
  employee       Employee?      @relation(fields: [employeeId], references: [id])
  
  auditLogs      AuditLog[]     // Actions performed by this user (Manager)
  createdAt      DateTime       @default(now())
}

// Audit Log for Manager Actions
model AuditLog {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  action         String         // e.g., "Created Invoice", "Deleted Expense"
  details        String         // JSON or text description
  createdAt      DateTime       @default(now())
}

// Clients (Customers and Suppliers)
model Client {
  id             String         @id @default(cuid())
  type           String         // "customer" or "supplier"
  name           String
  phone          String
  address        String?
  image          String?        @db.Text // Company Photo / Logo (Base64)
  openingBalance Float          @default(0) // Positive = Receivable, Negative = Payable
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  // Relations
  invoices       Invoice[]
  transactions   Transaction[]
  user           User?          // Login account for this client
  loans          Loan[]
}

// Employees
model Employee {
  id             String         @id @default(cuid())
  type           String         // "permanent" or "daily"
  name           String
  phone          String
  designation    String?
  joiningDate    DateTime?
  salaryAmount   Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  salariesPaid   Expense[]      // Salaries are recorded as expenses
  user           User?          // Login account for this employee (if MANAGER)
  attendances    Attendance[]   // Daily attendance records
  loans          Loan[]
}

// Attendance
model Attendance {
  id             String         @id @default(cuid())
  date           DateTime       @default(now())
  dateString     String         // Format: YYYY-MM-DD for uniqueness
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  status         String         // "PRESENT", "ABSENT", "HALF_DAY", "LEAVE"
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([dateString, employeeId])
}

// Expense Categories
model ExpenseCategory {
  id             String         @id @default(cuid())
  name           String         @unique
  createdAt      DateTime       @default(now())
  expenses       Expense[]
}

// Daily Expenses
model Expense {
  id             String         @id @default(cuid())
  date           DateTime       @default(now())
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  employeeId     String?
  employee       Employee?      @relation(fields: [employeeId], references: [id])
  paidTo         String?
  amount         Float
  description    String
  paymentMethod  String         
  isPersonal     Boolean        @default(false) // Whether it's an Owner's personal expense
  status         String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  requestedBy    String?        // ID of user who requested
  createdAt      DateTime       @default(now())
  
  transactionId  String?        @unique
  transaction    Transaction?   @relation(fields: [transactionId], references: [id])
}

// Data Correction Requests (Two-way error correction)
model CorrectionRequest {
  id             String         @id @default(cuid())
  requesterId    String         // Who asked for the change (Owner/Client)
  responderId    String         // Who needs to approve (Client/Owner)
  targetType     String         // "INVOICE", "TRANSACTION", etc.
  targetId       String         // ID of the record to change
  details        String         // What needs to be changed and why
  status         String         @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Products (Inventory)
model Product {
  id             String         @id @default(cuid())
  name           String
  sku            String?
  stock          Int            @default(0)
  buyPrice       Float          @default(0)
  sellPrice      Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoiceItems   InvoiceItem[]
}

// Invoices (Product In / Out)
model Invoice {
  id             String         @id @default(cuid())
  type           String         // "product_in" or "product_out"
  date           DateTime       @default(now())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  totalAmount    Float          @default(0)
  paidAmount     Float          @default(0)
  paymentStatus  String         // "paid", "due", "partial"
  status         String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  requestedBy    String?        // ID of user who requested
  dueDate        DateTime?      // Promised Payment Date for dues
  paymentMethod  String?        // "cash", "mobile_banking", "bank"
  createdAt      DateTime       @default(now())

  items          InvoiceItem[]
  transactions   Transaction[]
}

// Items inside an invoice
model InvoiceItem {
  id             String         @id @default(cuid())
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id])
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  quantity       Int
  pricePerUnit   Float
  total          Float
}

// Main Cash (Ledger)
model Transaction {
  id             String         @id @default(cuid())
  date           DateTime       @default(now())
  type           String         // "in" or "out"
  amount         Float
  description    String
  status         String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  requestedBy    String?        // ID of user who requested
  
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  invoiceId      String?
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  
  expense        Expense?
  loan           Loan?

  createdAt      DateTime       @default(now())
}

// Loans and Advances
model Loan {
  id             String         @id @default(cuid())
  type           String         // "GIVE" (ধার দেওয়া - cash out), "TAKE" (ধার নেওয়া - cash in)
  personType     String         // "CLIENT", "EMPLOYEE", "OTHER"
  personName     String
  phone          String?
  amount         Float
  notes          String?
  paymentMethod  String         @default("cash") // "cash", "bank"
  status         String         @default("APPROVED") // PENDING, APPROVED, REJECTED
  date           DateTime       @default(now())
  
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  employeeId     String?
  employee       Employee?      @relation(fields: [employeeId], references: [id])
  
  transactionId  String?        @unique
  transaction    Transaction?   @relation(fields: [transactionId], references: [id])
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Automated 2nd Backup Vault (Immutable Secondary Store)
model BackupVault {
  id          String   @id @default(cuid())
  trigger     String   // e.g., "AUTO_INVOICE_CREATED", "AUTO_CLIENT_CREATED", "MANUAL_SNAPSHOT"
  description String
  recordCount Int
  payload     String   @db.Text // Full JSON stringified database backup
  createdAt   DateTime @default(now())
}

// Business Settings & Owner Company Profile
model BusinessProfile {
  id          String   @id @default("default")
  companyName String   @default("BOLAKA FACTORY")
  ownerName   String?  @default("Hasibul Islam")
  phone       String?
  email       String?
  address     String?
  logo        String?  @db.Text // Owner company logo / photo (Base64)
  ownerPhoto  String?  @db.Text // Owner photo (Base64)
  updatedAt   DateTime @updatedAt
}

